 		}
 		catch(InvalidStateException &e) {
 			CCEC_LOG( LOG_DEBUG, "EOF for reader [%d]\r\n", isRunning());
+			/* The driver is not open (it never was, or it is being closed):
+			   there is nothing to wait on, so wait a while before asking again. */
+			if (isRunning()) usleep(100 * 1000);
 		}
 	}
 
