--- a/westeros-render-embedded.cpp
+++ b/westeros-render-embedded.cpp
@@ -2257,9 +2257,17 @@ static void wstRendererUpdateScene( WstRenderer *renderer )
    glUseProgram( program );
 
    #ifndef ENABLE_LEXPSYNCPROTOCOL
-   #if defined (WESTEROS_PLATFORM_NEXUS )
-   {
+   #if defined (WESTEROS_PLATFORM_NEXUS ) || defined (WESTEROS_RENDER_FINISH)
+   {
+      #if defined (WESTEROS_RENDER_FINISH)
+      /* A client's buffer is read where it is, and is given back to the client
+         when its next one is committed. Without fences, nothing else keeps the
+         client from drawing into it again before this drawing has been done.
+         WESTEROS_RENDER_NO_FINISH in the environment turns this off. */
+      static bool needFinish= (getenv("WESTEROS_RENDER_NO_FINISH") == NULL);
+      #else
       static bool needFinish= (getenv("WAYLAND_EGL_BNXS_ZEROCOPY") == NULL);
+      #endif
       // The calls to glFlush/glFinish are not required except on the Broadcom Nexus platform
       // when older versions of wayland-egl-bnxs are being used.  This code will be removed
       // in the near future.
