+
+/* Copies the two planes of an NV12 frame (brightness; colour, two bytes for
+   each sample) out of their buffers. False if a buffer cannot be mapped. */
+static bool wstRendererEMBCopyVideoPlanes( WstRenderSurface *surface, int *fd, int32_t *offset, int32_t *stride,
+                                           int frameWidth, int frameHeight )
+{
+   for( int i= 0; i < 2; ++i )
+   {
+      int width= (i == 0 ? frameWidth : frameWidth/2);
+      int height= (i == 0 ? frameHeight : frameHeight/2);
+      int rowBytes= (i == 0 ? width : width*2);
+      size_t length= (size_t)offset[i] + (size_t)stride[i]*height;
+      if ( (fd[i] < 0) || (stride[i] < rowBytes) || (height <= 0) )
+      {
+         return false;
+      }
+      unsigned char *data= (unsigned char*)mmap( NULL, length, PROT_READ, MAP_SHARED, fd[i], 0 );
+      if ( data == MAP_FAILED )
+      {
+         return false;
+      }
+      if ( surface->planeMem[i] && ((surface->planeWidth[i] != width) || (surface->planeHeight[i] != height)) )
+      {
+         free( surface->planeMem[i] );
+         surface->planeMem[i]= 0;
+      }
+      if ( !surface->planeMem[i] )
+      {
+         surface->planeMem[i]= (unsigned char*)malloc( (size_t)rowBytes*height );
+      }
+      if ( surface->planeMem[i] )
+      {
+         for( int row= 0; row < height; ++row )
+         {
+            memcpy( surface->planeMem[i] + (size_t)row*rowBytes, data + offset[i] + (size_t)row*stride[i], rowBytes );
+         }
+         surface->planeWidth[i]= width;
+         surface->planeHeight[i]= height;
+      }
+      munmap( data, length );
+      if ( !surface->planeMem[i] )
+      {
+         return false;
+      }
+   }
+   surface->planeDirty= true;
+   return true;
+}
