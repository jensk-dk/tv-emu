++++ b/hw/display/virtio-gpu-virgl.c
+@@ -1452,7 +1452,18 @@ static void virtio_gpu_fence_poll(void *opaque)
+     virgl_renderer_poll();
+     virtio_gpu_process_cmdq(g);
+     if (!QTAILQ_EMPTY(&g->cmdq) || !QTAILQ_EMPTY(&g->fenceq)) {
++#ifdef CONFIG_DARWIN
++        /*
++         * virglrenderer has no thread that watches the fences on macOS (it
++         * needs eventfd for one), so a fence is answered only when it is
++         * asked about here. A frame of a compositor has several fenced
++         * commands, and with 10 ms between the questions a guest that shows
++         * 60 frames a second got 25 through.
++         */
++        timer_mod(gl->fence_poll, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 1);
++#else
+         timer_mod(gl->fence_poll, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 10);
++#endif
+     }
+ }
