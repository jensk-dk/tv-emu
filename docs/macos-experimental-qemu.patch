++#if defined(CONFIG_DARWIN) && defined(CONFIG_OPENGL)
++/*
++ * macOS has neither a buffer of the GPU that another process can take
++ * (dma-buf) nor the shared texture of Windows. A scanout that the GPU drew
++ * is read back into the surface's memory and sent as pixels, with the
++ * methods every listener has (Scanout, Update).
++ *
++ * The frame buffer object that reads the texture belongs to one context,
++ * and virglrenderer's own contexts come and go on this thread: the reading
++ * is done in the display's own context, which shares the textures of all
++ * of them, and whichever was current is put back afterwards.
++ *
++ * dbus_gl_enter() is false where there is no OpenGL.
++ */
++typedef struct DBusGLSaved {
++    EGLContext ctx;
++    EGLSurface draw;
++    EGLSurface read;
++} DBusGLSaved;
++
++static bool dbus_gl_enter(DBusGLSaved *saved)
++{
++    /* EGL may not be there yet: nothing is asked of it before this */
++    saved->ctx = qemu_egl_display ? eglGetCurrentContext() : EGL_NO_CONTEXT;
++    if (saved->ctx != EGL_NO_CONTEXT && saved->ctx == qemu_egl_rn_ctx) {
++        return true;
++    }
++    if (saved->ctx != EGL_NO_CONTEXT) {
++        saved->draw = eglGetCurrentSurface(EGL_DRAW);
++        saved->read = eglGetCurrentSurface(EGL_READ);
++        /* what was drawn in that context is to be in the texture */
++        glFlush();
++    }
++    return dbus_gl_make_current_rn();
++}
++
++static void dbus_gl_leave(const DBusGLSaved *saved)
++{
++    if (saved->ctx != EGL_NO_CONTEXT && saved->ctx != qemu_egl_rn_ctx) {
++        eglMakeCurrent(qemu_egl_display, saved->draw, saved->read, saved->ctx);
++    }
++}
++
++static void dbus_gl_read_back(DBusDisplayListener *ddl)
++{
++    DBusGLSaved saved;
++    int width = surface_width(ddl->ds);
++    int height = surface_height(ddl->ds);
++    int stride = surface_stride(ddl->ds);
++    uint8_t *data = surface_data(ddl->ds);
++
++    if (!dbus_gl_enter(&saved)) {
++        return;
++    }
++    trace_dbus_gl_read_back(width, height, ddl->fb_y0_top);
++    egl_fb_read(ddl->ds, &ddl->fb);
++    dbus_gl_leave(&saved);
++
++    if (ddl->fb_y0_top) {
++        /*
++         * What is read comes with the texture's last row first. Where the
++         * guest's top row is the texture's first one, that is the bottom
++         * row first; seen with virglrenderer's scanout, which has it so.
++         */
++        g_autofree uint8_t *row = g_malloc(stride);
++        int y;
++
++        for (y = 0; y < height / 2; y++) {
++            uint8_t *upper = data + (size_t)stride * y;
++            uint8_t *lower = data + (size_t)stride * (height - 1 - y);
++
++            memcpy(row, upper, (size_t)width * 4);
++            memcpy(upper, lower, (size_t)width * 4);
++            memcpy(lower, row, (size_t)width * 4);
++        }
++    }
++}
++#endif
